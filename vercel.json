{
  "version": 2,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/uploads/(.*)", "destination": "/api/index" },
    { "source": "/webhook/(.*)", "destination": "/api/index" },
    { "source": "/((?!api/|uploads/|webhook/).*)", "destination": "/index.html" }
  ]
}

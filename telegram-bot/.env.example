# ============================================================
# KIROPRO Standalone USDT Telegram Bot Configuration
# ============================================================

# 1. Telegram Bot Token from @BotFather
BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# 2. Target Telegram Chat ID (Admin User ID or Admin Group ID)
# To find your ID, you can message @userinfobot or @raw_data_bot on Telegram
ADMIN_TELEGRAM_CHAT_ID=-1001234567890

# 3. KIROPRO Backend URL (Public URL of the backend where it is deployed)
# Example: https://api.kiropro.store or http://localhost:5000
KIROPRO_BACKEND_URL=https://api.kiropro.store

# 4. Secret Token for Bot <-> Backend Internal API authentication
# Must match BOT_API_SECRET in the backend .env
BOT_API_SECRET=your_secure_random_bot_api_secret_token_here

# 5. Polling Interval in milliseconds (Default: 10000 = 10 seconds)
REMINDER_INTERVAL_MS=10000

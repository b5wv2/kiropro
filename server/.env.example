# ==========================================
# KIROPRO Backend Environment Configuration
# ==========================================
# In Railway: Configure these variables in your Backend Service Variables.

# 1. Environment & Port (Railway assigns PORT dynamically)
NODE_ENV=production
PORT=5000

# 2. Frontend URL (Required for CORS and Cookie transmission across domains)
# Put your Railway Frontend service domain here (e.g. https://kiropro-web.up.railway.app)
# If you have multiple domains (e.g. custom domain + railway domain), separate with commas:
# FRONTEND_URL=https://kiropro.store,https://kiropro-web.up.railway.app
FRONTEND_URL=https://YOUR-FRONTEND-DOMAIN.up.railway.app

# 3. Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://username:password@ep-your-db-host.neon.tech/neondb?sslmode=require

# 4. Authentication & Security (Mandatory: use a strong cryptographically random secret)
JWT_SECRET=your_jwt_secret_key_here

# 5. Resend Email Provider Configuration
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM_EMAIL=no-reply@kiropro.store
RESEND_FROM_NAME=KIROPRO

# 6. GamesDrop Partner API Configuration
GAMESDROP_API_URL=https://partner.gamesdrop.io
GAMESDROP_API_TOKEN=your_gamesdrop_partner_api_token_here

# 7. Backend Domain / Public Base URL (Used for resolving local product image URLs)
# In Railway: Configure this variable in your Backend Service Variables:
BACKEND_URL=https://api.kiropro.store

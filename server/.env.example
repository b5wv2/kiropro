# Database Configuration (PostgreSQL / Neon)
DATABASE_URL=postgresql://username:password@ep-your-db-host.neon.tech/neondb?sslmode=require

# Authentication & Security
JWT_SECRET=your_jwt_secret_key_here
PORT=5000
FRONTEND_URL=http://localhost:5174

# Resend Email Provider Configuration
# Get your API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxx
# Configured sender email (must match your verified domain in Resend)
RESEND_FROM_EMAIL=no-reply@kiropro.store
RESEND_FROM_NAME=KIROPRO

# GamesDrop Partner API Configuration
GAMESDROP_API_URL=https://partner.gamesdrop.io
GAMESDROP_API_TOKEN=your_gamesdrop_shop_api_token_here
